<div class="max-w-7xl mx-auto">
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2">Quiz Administrasjon</h1>
    <p class="text-gray-600">Administrer alle quizzer i systemet</p>
  </div>

  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex justify-between items-center">
        <h2 class="text-xl font-semibold text-gray-900">Alle Quizzer (<%= quizzes.length %>)</h2>
        <a href="/admin" class="text-primary-600 hover:text-primary-800 font-medium">
          ← Tilbake til Dashboard
        </a>
      </div>
    </div>

    <% if (quizzes && quizzes.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Quiz
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Forfatter
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Kategori
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Spørsmål
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Gjennomføringer
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Status
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Opprettet
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Handlinger
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% quizzes.forEach(quiz => { %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-10 w-10">
                      <div class="h-10 w-10 rounded-full bg-primary-100 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </div>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900">
                        <%= quiz.title %>
                      </div>
                      <div class="text-sm text-gray-500">
                        <%= quiz.description.substring(0, 50) %><%= quiz.description.length > 50 ? '...' : '' %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900"><%= quiz.author.username %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= {
                    'programutvikling': 'bg-blue-100 text-blue-800',
                    'drift': 'bg-green-100 text-green-800',
                    'nettverk': 'bg-purple-100 text-purple-800',
                    'database': 'bg-yellow-100 text-yellow-800',
                    'annet': 'bg-gray-100 text-gray-800'
                  }[quiz.category] || 'bg-gray-100 text-gray-800' %>">
                    <%= {
                      'programutvikling': 'Programutvikling',
                      'drift': 'Drift',
                      'nettverk': 'Nettverk',
                      'database': 'Database',
                      'annet': 'Annet'
                    }[quiz.category] || 'Ukjent' %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= quiz.questions.length %> spørsmål
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= quiz.plays %> ganger
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= quiz.isPublic ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                    <%= quiz.isPublic ? 'Offentlig' : 'Privat' %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= new Date(quiz.createdAt).toLocaleDateString('no-NO') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <div class="flex space-x-2">
                    <a href="/admin/quiz/<%= quiz._id %>" class="text-primary-600 hover:text-primary-900">
                      Se detaljer
                    </a>
                    <a href="/quiz/play/<%= quiz._id %>" class="text-green-600 hover:text-green-900">
                      Spill
                    </a>
                    <button 
                      onclick="deleteQuiz('<%= quiz._id %>', '<%= quiz.title %>')"
                      class="text-red-600 hover:text-red-900"
                    >
                      Slett
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-8 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-lg font-medium text-gray-900 mb-2">Ingen quizzer funnet</h3>
        <p class="text-gray-500">Det er ingen quizzer opprettet i systemet ennå.</p>
        <div class="mt-4">
          <a href="/quiz/create" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700">
            Lag første quiz
          </a>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
function deleteQuiz(quizId, quizTitle) {
  if (confirm(`Er du sikker på at du vil slette quizen "${quizTitle}"? Dette kan ikke angres.`)) {
    fetch(`/admin/quiz/${quizId}/delete`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Feil ved sletting av quiz: ' + data.message);
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('En feil oppstod ved sletting av quizen.');
    });
  }
}
</script> 